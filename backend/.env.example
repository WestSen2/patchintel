# Copy to .env and fill in. Never commit .env.

# SQLite works out of the box (default). For Postgres instead, run
# `docker compose up -d` and switch to:
# DATABASE_URL=postgresql+psycopg://patchintel:patchintel@localhost:5432/patchintel
DATABASE_URL=sqlite:///./patchintel.db

# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Community Deadlock API (optional key raises rate limits)
DEADLOCK_API_BASE=https://api.deadlock-api.com
DEADLOCK_API_KEY=

# Optional: LLM patch summaries. Empty = heuristic fallback (works fine).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# App (used from M3 for session signing; any random string)
APP_SECRET_KEY=change-me
